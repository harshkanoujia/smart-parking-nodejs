# These are some examples of commonly ignored file patterns.

# Node artifact files
node_modules/
dist/

# certs
certs

# Log files
*.log

# Applications
*.app
*.exe
*.war

# Large media files
*.mp4
*.tiff
*.avi
*.flv
*.mov
*.wmv

# Generated by MacOS
.DS_Store

# Generated by Windows
Thumbs.db

# environment files
config/custom-environment-variables.json
config/default.json

# README file 
README.txt

# script
scripts/

# swagger output file
swagger-output.json